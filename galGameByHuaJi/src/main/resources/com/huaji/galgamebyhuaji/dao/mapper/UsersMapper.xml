    <update id="buyResources">
        update users u
        join resource_extension_information rei on rei.r_id = #{rId}
        <choose>
            <when test="isDown">
                set u.Coin = u.Coin - rei.download_locally_price
                where u.user_id = #{userId}
                and u.Coin >= rei.download_locally_price
            </when>
            <otherwise>
                set u.Coin = u.Coin - rei.link_price
                where u.user_id = #{userId}
                and u.Coin >= rei.link_price
            </otherwise>
        </choose>
    </update>
